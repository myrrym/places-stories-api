{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myrrym/places-stories-api/data/schema/place.schema.json",
  "title": "Place",
  "description": "One place and its stories. CI validates every file in data/places/ against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "lat", "lon"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Lowercase slug, unique across the dataset. Must match the filename.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "name_local": {
      "type": ["string", "null"],
      "maxLength": 200,
      "description": "Name in Malay, Chinese, Tamil or Jawi where one is in common use."
    },
    "category": {
      "type": "string",
      "enum": ["historic", "religious", "museum", "natural", "market", "landmark"]
    },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "address": { "type": ["string", "null"], "maxLength": 300 },
    "city": { "type": ["string", "null"], "maxLength": 120 },
    "state": { "type": ["string", "null"], "maxLength": 120 },
    "osm_type": { "type": ["string", "null"], "enum": ["node", "way", "relation", null] },
    "osm_id": { "type": ["integer", "null"] },
    "wikidata_id": { "type": ["string", "null"], "pattern": "^Q[0-9]+$" },
    "wikipedia_title": {
      "type": ["string", "null"],
      "description": "English Wikipedia article title, used by the enrichment step."
    },
    "stories": {
      "type": "array",
      "description": "May be empty. A place with no confident source match ships story-less.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title", "body_md", "source_name", "source_url", "license", "match_method"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "body_md": { "type": "string", "minLength": 1 },
          "lang": { "type": "string", "default": "en", "maxLength": 8 },
          "source_name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "source_url": { "type": "string", "format": "uri", "maxLength": 600 },
          "license": {
            "type": "string",
            "description": "SPDX-ish licence label of the source text.",
            "minLength": 1,
            "maxLength": 80
          },
          "retrieved_at": { "type": ["string", "null"], "format": "date" },
          "match_method": { "type": "string", "enum": ["wikidata", "geosearch", "manual"] },
          "match_confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 }
        }
      }
    }
  }
}
