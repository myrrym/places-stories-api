# Copy to .env for local runs. docker compose reads this file.
# Postgres / PostGIS
# Inside compose the hosts are the service names 'db' and 'cache'.
# From the host machine use localhost:55432 and localhost:56379.
POSTGRES_USER=places
POSTGRES_PASSWORD=places
POSTGRES_DB=places
DATABASE_URL=postgresql+asyncpg://places:places@db:5432/places

# Redis
REDIS_URL=redis://cache:6379/0

# Cache tuning
CACHE_VERSION=v1
PLACE_TTL_SECONDS=86400
NEAR_TTL_SECONDS=600
LIST_TTL_SECONDS=600
GEOHASH_PRECISION=6
RADIUS_BUCKETS_M=[500,1000,2000,5000,10000,25000]
MAX_RADIUS_M=50000
NEAR_SUPERSET_CAP=500

# Rate limiting (per client IP)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=1000
# Only trust X-Forwarded-For from these CIDRs, e.g. ["10.0.0.0/8"]
TRUSTED_PROXY_CIDRS=[]

# App
# Host port the API is published on. Change if 8000 is already in use.
API_PORT=8000
LOG_LEVEL=INFO
API_ROOT_PATH=
